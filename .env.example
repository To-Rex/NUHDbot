# Copy to .env and fill in. Do NOT put comments on the same line as a value.
DEBUG=false
SECRET_KEY=replace-with-a-long-random-string
# Public https URL of the app (Telegram Mini App requires https)
BASE_URL=https://your-domain.example
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/nuhdbot

# Token from @BotFather. Never commit this.
BOT_TOKEN=
BOT_USERNAME=Unetik_bot
# polling | webhook | off
BOT_MODE=polling
WEBHOOK_SECRET=change-me
# Optional Telegram group id for staff alerts (leave empty if none)
ADMIN_CHAT_ID=

ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-now
DEFAULT_CURRENCY=USD
TIMEZONE=Asia/Shanghai
# Apply DB migrations automatically on startup
RUN_MIGRATIONS=true
