# Copy to .env and fill in
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string
BASE_URL=https://your-public-https-domain.example   # Mini App requires https (use ngrok / cloudflared in dev)
DATABASE_URL=postgresql+asyncpg://localhost:5432/nuhdbot

BOT_TOKEN=123456:ABC...        # from @BotFather — never commit this
BOT_USERNAME=Unetik_bot
BOT_MODE=polling               # polling | webhook | off
WEBHOOK_SECRET=change-me
ADMIN_CHAT_ID=                 # optional staff group id for alerts

ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-now
DEFAULT_CURRENCY=USD
TIMEZONE=Asia/Shanghai
