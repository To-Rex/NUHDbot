# Caddy gets HTTPS automatically (required for Telegram Mini Apps). Replace the domain.
hdd.example.com {
    encode zstd gzip
    @static path /static/*
    header @static Cache-Control "public, max-age=31536000, immutable"
    reverse_proxy 127.0.0.1:8000 {
        flush_interval -1   # needed for SSE (/api/auctions/*/stream)
    }
}
